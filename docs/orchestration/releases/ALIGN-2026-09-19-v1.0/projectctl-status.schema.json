{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Planton361/autonomous-game-agent/blob/main/docs/orchestration/releases/ALIGN-2026-09-19-v1.0/projectctl-status.schema.json",
  "title": "Future projectctl handoff/status contract",
  "description": "Machine-readable status contract for the ALIGN-2026-09-19-v1.0 control workflow. This schema does not authorize live execution or merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "alignment_release",
    "repository",
    "observed_at",
    "source_ref",
    "task",
    "dependencies",
    "gates",
    "validation",
    "status",
    "limitations",
    "next_step"
  ],
  "properties": {
    "schema_id": {
      "const": "projectctl-status"
    },
    "schema_version": {
      "const": "1.0"
    },
    "alignment_release": {
      "const": "ALIGN-2026-09-19-v1.0"
    },
    "repository": {
      "const": "Planton361/autonomous-game-agent"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "branch", "dirty"],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "title", "scope", "non_goals", "state"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "research",
            "decision",
            "implementation",
            "verification",
            "live"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "enum": [
            "proposed",
            "ready",
            "in_progress",
            "ready_for_review",
            "merged",
            "partial",
            "blocked",
            "superseded"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["pending", "satisfied", "blocked", "not_applicable"]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "canonical_or_protocol_change",
        "scientific_freeze",
        "live_authorization",
        "focused_validation",
        "ci",
        "review",
        "merge"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/gate" },
        "canonical_or_protocol_change": { "$ref": "#/$defs/gate" },
        "scientific_freeze": { "$ref": "#/$defs/gate" },
        "live_authorization": { "$ref": "#/$defs/gate" },
        "focused_validation": { "$ref": "#/$defs/gate" },
        "ci": { "$ref": "#/$defs/gate" },
        "review": { "$ref": "#/$defs/gate" },
        "merge": { "$ref": "#/$defs/gate" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "enum": ["not_run", "passed", "failed", "partial", "blocked"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command", "outcome"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": ["passed", "failed", "not_run", "blocked"]
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "in_progress",
        "ready_for_review",
        "partial",
        "blocked",
        "merged",
        "superseded"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "owner", "gate"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_refs"],
      "properties": {
        "state": {
          "enum": [
            "not_required",
            "pending",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
